{
  "expo": {
    "name": "Move Sync",
    "slug": "move-sync",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/move-sync-icon-v2.png",
    "splash": {
      "image": "./assets/move-sync-splash-v2.png",
      "resizeMode": "contain",
      "backgroundColor": "#0A0F17"
    },
    "userInterfaceStyle": "dark",
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "app.movesync.mobile"
    },
    "android": {
      "package": "app.movesync.mobile",
      "adaptiveIcon": {
        "backgroundColor": "#050B12",
        "foregroundImage": "./assets/move-sync-android-foreground-v2.png",
        "backgroundImage": "./assets/android-icon-background.png",
        "monochromeImage": "./assets/android-icon-monochrome.png"
      },
      "predictiveBackGestureEnabled": false
    },
    "web": {
      "favicon": "./assets/move-sync-icon-v2.png"
    },
    "plugins": [
      "expo-font",
      [
        "expo-video",
        {
          "supportsPictureInPicture": true
        }
      ],
      "expo-background-task",
      [
        "expo-media-library",
        {
          "photosPermission": "Move Sync needs access to your videos so you can choose collections to sync.",
          "granularPermissions": ["video"],
          "isAccessMediaLocationEnabled": true
        }
      ],
      "expo-secure-store",
      "./plugins/withShortAndroidCmakePaths"
    ]
  }
}
